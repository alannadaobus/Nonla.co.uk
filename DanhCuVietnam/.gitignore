# Unity project ignore rules (paths are relative to this folder).

# Generated by the editor - never commit
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/[Ss]treamingAssets/aa/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE generated project files (Unity regenerates them)
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and build output
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app
*.ipa
/[Aa]ssets/[Pp]lugins/[Ee]ditor/[Jj]et[Bb]rains*

# Addressables / Burst / test output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
*_BurstDebugInformation_DoNotShip/
TestResults*.xml
